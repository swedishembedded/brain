#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Martin Schröder <info@swedishembedded.com>

# Git pre-commit hook: blocks a commit that touches a source file missing the
# SPDX-License-Identifier/copyright header (scripts/spdx/check.py has the
# actual rules). Installed via `make hooks/install`; this is the no-extra-
# dependency path — see .pre-commit-config.yaml for the same check via the
# `pre-commit` framework, for anyone already using it.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

mapfile -d '' -t staged < <(git diff --cached --name-only --diff-filter=ACM -z)
[ "${#staged[@]}" -eq 0 ] && exit 0

python3 scripts/spdx/check.py "${staged[@]}"
