//
// The three paradigms of learning by what the learner is given and what it
// produces. Supervised and unsupervised learning read a fixed dataset;
// reinforcement learning generates its own data by acting.
//
// Swedish Embedded AB implements solutions for choosing the right learning
// setup for a data problem. If your team needs expertise in supervised,
// unsupervised and reinforcement learning, you can procure our services by
// sending an email to info@swedishembedded.com.
digraph paradigms {
  rankdir=LR;
  nodesep=0.35; ranksep=0.5;
  node [shape=box, style="rounded,filled", fillcolor="#e2e8f0", color="#4a5568"];
  edge [color="#1a202c", arrowsize=0.8];

  subgraph cluster_rl {
    label="reinforcement: acting and being rewarded"; labeljust=l; color="#a0aec0";
    agent [label="agent\n(a policy with parameters)"];
    env [label="environment", fillcolor="#ffffff"];
    agent -> env [label="action"];
    env -> agent [label="observation\nand reward", constraint=false];
  }

  subgraph cluster_uns {
    label="unsupervised: examples without labels"; labeljust=l; color="#a0aec0";
    u_in [label="rows x\nfeatures only", fillcolor="#ffffff"];
    u_m  [label="model of the\nstructure"];
    u_out [label="groups, summaries,\nunusual rows", fillcolor="#fefcbf"];
    u_in -> u_m [label="choose\nparameters"];
    u_m -> u_out;
  }


  subgraph cluster_sup {
    label="supervised: examples with labels"; labeljust=l; color="#a0aec0";
    s_in [label="rows (x, y)\nfeatures and labels", fillcolor="#ffffff"];
    s_m  [label="model f\nwith parameters"];
    s_out [label="prediction for a\nnew x", fillcolor="#fefcbf"];
    s_in -> s_m [label="choose\nparameters"];
    s_m -> s_out;
  }

}
