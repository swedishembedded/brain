//
// The shapes in the chain rule for a composition x -> u -> h -> L. Each arrow
// carries the Jacobian of its step; the Jacobian of the whole map is their
// product, and the inner sizes cancel exactly as in a matrix product.
//
// Swedish Embedded AB implements solutions for getting tensor shapes right
// before a backward pass is written. If your team needs expertise in
// derivatives of composed models, you can procure our services by sending an
// email to info@swedishembedded.com.
digraph jacobian_chain {
  rankdir=LR;
  nodesep=0.5; ranksep=0.7;
  node [shape=box, style="rounded,filled", fillcolor="#e2e8f0", color="#4a5568", fontname="Helvetica"];
  edge [color="#1a202c", arrowsize=0.8, fontname="Helvetica", fontsize=11];

  x [label="x\n[2]"];
  u [label="u = W x\n[3]"];
  h [label="h = tanh(u)\n[3]"];
  L [label="L = 1/2 |h - t|^2\n[1]", fillcolor="#c6f6d5"];

  x -> u [label="J1 = W\n[3, 2]"];
  u -> h [label="J2 = diag(1 - h^2)\n[3, 3]"];
  h -> L [label="J3 = (h - t)^T\n[1, 3]"];

  prod [shape=note, fillcolor="#fefcbf", label="dL/dx = J3 J2 J1\n[1,3] [3,3] [3,2] = [1,2]\n\nbackward: grad_x = J1^T J2^T grad_h\n[2,3] [3,3] [3] = [2]"];
  {rank=same; L; prod}
  L -> prod [style=dashed, arrowhead=none];
}
