//
// A composition as a pipeline: four small functions applied one after another,
// with the set each value lives in under each arrow. The chapter's worked
// example evaluates exactly this chain, and the last arrow shows why the
// domain of the whole is not the domain of the first stage alone.
//
// Swedish Embedded AB implements solutions for explaining how models are built
// from simple stages. If your team needs expertise in layered model design,
// you can procure our services by sending an email to info@swedishembedded.com.
digraph composition {
  rankdir=TB;
  nodesep=0.3; ranksep=0.28;
  node [shape=ellipse, style=filled, fillcolor="#ffffff", color="#4a5568"];
  edge [color="#1a202c", arrowsize=0.8];

  x [label="x\nany real"];
  a [label="a\nany real"];
  b [label="b\nb >= 0"];
  b1 [label="b + 1\nb + 1 >= 1"];
  c [label="c\nc >= 0", fillcolor="#fefcbf"];

  node [shape=box, style="rounded,filled", fillcolor="#e2e8f0"];
  f1 [label="f1\na = 3x - 2"];
  f2 [label="f2\nb = a^2"];
  f3 [label="f3\nb + 1"];
  f4 [label="f4\nc = log(b + 1)"];

  x -> f1 -> a -> f2 -> b -> f3 -> b1 -> f4 -> c;
}
