# Rust build output (workspace + legacy single-crate layout)
target/

# Scratchpad: untracked experiments, scratch weights, images, and porting
# reference material. Never committed — see scratchpad/README.md.
scratchpad/

/.todo/

# Local convenience symlink to an external checkpoint/reference-source mirror
# some real-weight tests fall back to (`<repo>/resources/ltxv/weights/...`,
# `<repo>/resources/ltxv/source/...`). NEVER commit this - it is a bare
# machine-specific absolute path, exactly what fetch-testdata.sh's own
# BRAIN_*_MIRROR convention exists to keep out of the tree.
/resources

# Generated training data and trained checkpoints (regenerate via `make data/*`).
/data/
/out/
*.bin
*.pt
*.weights
*.npy
# Generated media. The quickstart and `brain wan t2v` write video next to the
# stills the docs embed; the still is what gets committed, never the clip.
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.m4v


# Python caches (reference scripts live under scratchpad/reference only).
__pycache__/
*.pyc
.mypy_cache

# Run-output artifacts: `brain bench eval`/`scale`, `brain perf run`/`compare`,
# and ad-hoc script output (e.g. scripts/run_s3dit_int8_e2e.sh) all write here.
# Nothing under it is committed, and no placeholder is needed to hold the
# directory open: every writer calls create_dir_all on the parent first.
/results/

# Session-local agent machinery (worktrees, locks, loop state, workflows).
.claude/*
!.claude/commands/

# Generated world-model artifacts: parity fixtures (regenerate with
# `make wm-fixtures`) and demo output.
crates/diamond/tests/fixtures/
/out/wm-demos/

# depth demo test artifacts (never commit — regenerable)
photo.ppm
*-depth.ppm
out/depth.ppm

# generated documentation bundle (regenerate with 'make docs')
/build/

# Test fixtures (checkpoints/goldens/audio) — populated by `make fetch/testdata`, never committed.
/testdata/

# brain perf baselines are a snapshot of one machine's absolute numbers, not
# portable source - capture locally via each *-perf-gate.sh script's --update
# flag, never commit (see scripts/gates/check-large-files.sh rule 2).
scripts/gates/*-perf-baselines/
scripts/gates/*-perf-baselines.json

# Binary model tensors must NEVER be committed — they are multi-MB blobs that bloat
# history irreversibly. Test goldens are regenerated/fetched, not tracked.
*.safetensors
*.gguf
*.ckpt
